unconstrained fn pairs_helper(x: Field) -> [(Field, Field); 2] {
    [(x, x), (x, x)]
}

fn main(x: Field) -> pub Field {
    // Safety: comment added by `nargo expand`
    let pairs: [(Field, Field); 2] = unsafe { pairs_helper(x) };
    assert(pairs[0_u32].0 == x);
    assert(pairs[0_u32].1 == x);
    pairs[1_u32].0 + pairs[1_u32].1
}
