unconstrained fn f(x: u32) -> u32 {
    let mut i: u32 = 0_u32;
    let mut c: u32 = 0_u32;
    loop {
        if i < 10_u32 {
            c = c + 1_u32;
        } else {
            c = c + 100_u32;
        };
        if i == 12_u32 { break; };
        if i == x { break; };
        i = i + 1_u32;
    }
    c
}

fn main(x: u32) -> pub u32 {
    // Safety: comment added by `nargo expand`
    unsafe {
        f(x)
    }
}
