fn main(flag: bool) -> pub Field {
    let mut out: Field = 0_Field;
    if flag {
        let mut values: [(Field, Field)] = @[(1_Field, 2_Field)];
        if flag {
            values = values.push_back(values[1_u32]);
        };
        if flag {
            let zero: u32 = 0_u32;
            let q: u32 = 7_u32 / zero;
            values = values.push_back((q as Field, 0_Field));
        };
        out = values[0_u32].0;
    };
    out
}
