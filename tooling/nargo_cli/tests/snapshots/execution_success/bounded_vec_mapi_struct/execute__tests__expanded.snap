---
source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
struct Entry {
    amount: u64,
    index: u32,
    value: Field,
    tag: u8,
    first: bool,
}

fn main(xs: [Field; 32], len: u32) -> pub Field {
    let vec: BoundedVec<Field, 32> = BoundedVec::<Field, 32>::from_parts(xs, len);
    let mapped: BoundedVec<Entry, 32> = vec.mapi(|i: u32, x: Field| -> Entry {
        Entry { amount: x as u64, index: i, value: x * 2_Field, tag: i as u8, first: i == 0_u32 }
    });
    assert(mapped.len() == len);
    let mut acc: Field = 0_Field;
    for i in 0_u32..32_u32 {
        let e: Entry = mapped.get_unchecked(i);
        if i < len {
            assert(e.value == (xs[i] * 2_Field));
            assert(e.index == i);
        } else {
            assert(e.value == 0_Field);
            assert(e.amount == 0_u64);
        };
        acc = acc
            + (
                ((((e.amount as Field) + (e.index as Field)) + e.value) + (e.tag as Field))
                    + (e.first as Field)
            );
    }
    acc
}
