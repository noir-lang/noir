source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
unconstrained fn main(a: [Field; 2], c: [Field; 2], n: u32) {
    let mut a: [Field; 2] = a;
    let mut c: [Field; 2] = c;
    for _j in 0_u32..n {
        let t: [Field; 2] = a;
        a = c;
        c = t;
    }
    c[0_u32] = c[0_u32] + 1_Field;
    assert(a == [10_Field, 20_Field]);
    assert(c == [2_Field, 2_Field]);
}
