struct Holder {
    cell: &mut Field,
}

fn write(h: &mut Holder, v: Field) {
    *h.cell = v;
}

fn main(x: Field, y: Field) -> pub Field {
    let mut a: Field = x;
    let cell: &mut Field = &mut a;
    let mut h: Holder = Holder { cell: cell };
    let arr: [(&mut Field, &mut Holder); 1] = [(cell, &mut h)];
    *cell = y;
    write(&mut h, y * 2_Field);
    *arr[0_u32].0
}
