unconstrained fn hint(_x: [Field; 2]) {}

fn main(x: [Field; 2]) {
    // Safety: comment added by `nargo expand`
    unsafe {
        hint(
            x.map(|v: Field| -> Field {
                assert(v == 7_Field, "v must be 7");
                v
            }),
        );
    }
}
